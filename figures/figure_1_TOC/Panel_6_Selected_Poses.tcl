if {1} {
update idletasks
namespace eval ::optionA_panel {
    variable molecule_ids
    if {![info exists molecule_ids]} {set molecule_ids {}}
}
proc ::optionA_panel::create_molecule {rows} {
    set m [mol new atoms [llength $rows]]
    animate dup $m
    set atoms [atomselect $m all]
    $atoms set {name type element mass radius resid resname chain segname occupancy beta x y z} $rows
    $atoms delete
    return $m
}
